# a rails 5 app that got some love but not enough.
# the big gems are fine. the dependencies around them tell a different story.

source "https://rubygems.org"

gem "rails", "~> 5.2"
gem "pg", "~> 1.1"
gem "rack"                # pillar — beloved
gem "activesupport"       # pillar — beloved
gem "nokogiri"            # pillar — beloved
gem "puma", "~> 3.12"
gem "sass-rails"          # sprockets-era sass. the era has ended.
gem "uglifier"            # deprecated. asset pipeline relic.
gem "coffee-rails"        # coffescript. yes. coffescript.
gem "jquery-rails"        # predates webpacker, predates importmaps
gem "turbolinks"          # replaced by turbo. been replaced for years.
gem "jbuilder"
gem "bootsnap", require: false
gem "byebug"