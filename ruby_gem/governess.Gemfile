# a modern rails 7 app built in the last year.
# hotwire, importmaps, solid queue — the current idiom.
# every gem here had a release in the last few months.

source "https://rubygems.org"

ruby "3.3.0"

gem "rails", "~> 7.1"
gem "turbo-rails"
gem "stimulus-rails"
gem "importmap-rails"
gem "solid_queue"
gem "solid_cache"
gem "kamal"
gem "puma", "~> 6.0"
gem "pg", "~> 1.5"
gem "propshaft"
gem "rubocop-rails-omakase", require: false
gem "brakeman", require: false
gem "web-console"