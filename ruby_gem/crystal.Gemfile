# the foundational layer of ruby. not a product gemfile.
# this is what the tooling itself depends on.
# these gems are in half the rubygems on the planet.

source "https://rubygems.org"

gem "bundler"
gem "rake"
gem "rack"
gem "minitest"
gem "rspec"
gem "rubocop"
gem "nokogiri"
gem "json"
gem "faraday"
gem "httparty"
gem "activesupport"
gem "concurrent-ruby"
gem "tzinfo"
gem "i18n"