# a legacy rails 4 monolith that nobody has touched since the last reorg.
# it works. probably. nobody checks.

source "https://rubygems.org"

gem "rails", "~> 4.2"
gem "mysql2", "~> 0.4"
gem "passenger"
gem "paperclip"           # last release: 2018. famously abandoned.
gem "acts-as-taggable-on" # old version, was abandoned for years
gem "will_paginate"
gem "cancan"              # original cancan, not cancancan. archived.
gem "whenever"
gem "exception_notification"
gem "carrierwave"
gem "ransack"
gem "spreadsheet"
gem "axlsx"               # old axlsx gem, superseded by caxlsx
gem "prawn"