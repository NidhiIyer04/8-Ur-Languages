# signal: all gems actively maintained, none ancient, none missing

# a modern rails api stack. everything here had a release in the last year.
# tight, purposeful, no dead weight.

source "https://rubygems.org"

ruby "3.3.0"

gem "rails", "~> 7.1"
gem "puma", "~> 6.4"
gem "pg", "~> 1.5"
gem "redis", "~> 5.0"
gem "sidekiq", "~> 7.2"
gem "devise", "~> 4.9"
gem "pundit", "~> 2.3"
gem "pagy", "~> 6.2"
gem "dry-validation", "~> 1.10"
gem "faraday", "~> 2.9"
gem "zeitwerk", "~> 2.6"
gem "bootsnap", require: false