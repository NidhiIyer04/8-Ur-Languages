# a rails 3 app. someone deployed this in 2013 and it has been running since.
# the server is physical. nobody knows where it is.

source "https://rubygems.org"

gem "rails", "~> 3.2"
gem "mysql2", "~> 0.3"
gem "authlogic"             # last meaningful activity: 2014 era
gem "paperclip"             # abandoned 2018
gem "will_paginate"         # still around but untouched for ages
gem "cancan"                # archived original cancan
gem "nifty-generators"      # ryan bates. archived 2013.
gem "dynamic_form"          # extracted from rails 3, never updated
gem "client_side_validations" # abandoned
gem "money"
gem "whenever"
gem "our_internal_billing", path: "../billing"   # private/path — won't be found
gem "our_auth_wrapper", git: "git@github.com:company/auth" # git — won't be found